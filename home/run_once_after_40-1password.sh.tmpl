{{ if and (eq .role "omarchy") (default false (get . "setupEnabled")) -}}
#!/usr/bin/env bash
set -euo pipefail
systemctl --user set-environment "SSH_AUTH_SOCK=$HOME/.1password/agent.sock"
if [[ ! -S $HOME/.1password/agent.sock ]]; then
  # Account sign-in and enabling the agent are authorized in the desktop app.
  # Launch its settings, but don't block the rest of bootstrap on account access.
  nohup 1password 'onepassword://settings/developers' >/dev/null 2>&1 </dev/null &
  printf '\n1Password SSH setup: sign in, then enable "Use the SSH Agent" in Settings > Developer.\n'
  printf 'For the op CLI, enable "Unlock using system authentication" under Security and "Integrate with 1Password CLI" under Developer.\n'
  printf 'Your Personal/Private/Employee SSH Key items will then be available automatically.\n'
fi
{{ end -}}
