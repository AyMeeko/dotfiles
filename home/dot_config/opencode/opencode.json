{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "snapshots": false,
  "default_agent": "betterplan",
  "agents": {
    "plan": { "disabled": true }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/notes/ai/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "shell", "resource": "git commit *--no-verify*", "effect": "ask" },
    { "action": "shell", "resource": "git commit * -n*", "effect": "ask" },
    { "action": "edit", "resource": "**/.superpowers/**", "effect": "deny" }
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#8ca22dba9a94f28898bbce59f2537ff4d87c747d",
    {
      "package": "@plannotator/opencode@0.28.7",
      "options": { "workflow": "manual" }
    }
  ]
}
